# =============================================================================
# Hyperliquid Trading Bot Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Your wallet private key (without 0x prefix)
HYPERLIQUID_PRIVATE_KEY=

# Environment: "testnet" or "production"
# - testnet:     Fake tokens, for testing the bot and strategy
# - production:  Real tokens, real money at risk
# DEFAULT: testnet
ENVIRONMENT=testnet

# =============================================================================
# TRADING SETTINGS
# =============================================================================

# Trading pairs (comma-separated, 1-3 pairs max)
# Examples: BTC, ETH, SOL, DOGE
TRADING_PAIRS=BTC,ETH

# Leverage (1-3x only for safety)
LEVERAGE=1

# Capital allocated to bot in USDC
CAPITAL_USDC=1000

# Candle timeframe: 1m, 5m, 15m, 1h, 4h, 1d
TIMEFRAME=1h

# Number of candles to fetch for indicator calculation
# Higher values = more reliable indicators but slower API response
CANDLES_LIMIT=500

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Strategy parameters
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
EMA_TREND_PERIOD=200
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Risk management
RISK_PER_TRADE=0.01
REWARD_TO_RISK_RATIO=2.0
ATR_MULTIPLIER_SL=2.0
TRAILING_STOP_ENABLED=true
TRAILING_STOP_ATR_MULT=1.5

# API retry settings
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
API_TIMEOUT_THRESHOLD=300
